# Constitution Quest: environment template.
# Copy to backend/.env and adjust. NEVER commit real .env.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/constitution

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API hardening ---
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info